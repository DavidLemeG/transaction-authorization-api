      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"accountId\": \"UUID_ESPECIFICO\",\n  \"type\": \"CREDIT\",\n  \"amount\": { \"value\": 100.00, \"currency\": \"BRL\" }\n}"
      },
